{
  "_note": "Portable TEMPLATE — NOT symlinked. The live ~/.claude/settings.json is app-rewritten (atomic writes break symlinks) and holds work-specific marketplaces/plugins, so it stays local. This captures the portable pieces — most importantly the agent-state hooks that drive the tmux session-switcher glyphs (set-agent-state.sh @claude). Merge changes by hand; keep secrets and work-specific entries only in the live file.",
  "permissions": {
    "allow": [
      "Bash(npm run generate-graphql-typescript:*)",
      "Bash(npm run dev:tsc:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(pnpm test:*)",
      "Bash(npx graphql-codegen:*)",
      "Bash(pnpm install)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run dev:tsc:*)",
      "Bash(pnpm run test-db:*)",
      "Bash(npx eslint:*)",
      "Bash(gh pr view:*)",
      "Bash(gh api:*)",
      "Bash(pnpm --version:*)",
      "Bash(bash */.claude/skills/pr-scripts/*.sh *)",
      "Bash(bash */.claude/skills/create-pr/scripts/*.sh *)",
      "Bash(bash */.claude/skills/grumpy-review/scripts/*.sh *)"
    ],
    "deny": ["Bash(terraform apply:*)"],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(jq -r '.message // \"Claude needs your attention\"' 2>/dev/null || echo 'Claude needs your attention'); \"$HOME/.claude/hooks/notify-desktop.sh\" \"$msg\" Ping"
          },
          {
            "type": "command",
            "command": "msg=$(jq -r '.message // \"\"' 2>/dev/null || echo ''); case \"$msg\" in *\"waiting for your input\"*) exit 0 ;; esac; \"$HOME/.helpful/tmux/set-agent-state.sh\" @claude waiting"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff &"
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/notify-desktop.sh\" \"Permission needed\" Funk"
          },
          {
            "type": "command",
            "command": "\"$HOME/.helpful/tmux/set-agent-state.sh\" @claude waiting"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "id": "block-reset-hard-local",
        "description": "Block reset hard to local refs — rewrites or discards local commit history",
        "operation": "git-reset-hard",
        "deny-targets": [
          "HEAD~*",
          "HEAD^*",
          "HEAD@*"
        ],
        "action": "deny",
        "reason": "Rewinding local commits can cause data loss — confirm this is intentional before proceeding"
      },
      {
        "id": "block-push-main",
        "description": "Block direct push to main or master — these require a PR",
        "operation": "git-push-direct",
        "deny-branches": [
          "main",
          "master"
        ],
        "action": "deny",
        "reason": "Direct push to main/master not permitted — open a PR"
      },
      {
        "id": "block-gh-api-delete",
        "description": "Block gh api DELETE calls — these are irreversible",
        "operation": "gh-api",
        "deny-methods": [
          "DELETE"
        ],
        "action": "deny",
        "reason": "Destructive GitHub API operations require manual confirmation from the user"
      },
      {
        "id": "block-gh-repo-delete",
        "description": "Block repo deletion via gh",
        "pattern": "gh repo delete",
        "action": "deny",
        "reason": "Repository deletion is irreversible"
      },
      {
        "id": "block-rm-home",
        "description": "Block rm targeting home directory — rm ~/ would destroy the user environment",
        "pattern": "rm\\b[^&|;\\n]*\\s~/",
        "action": "deny",
        "reason": "Removing files from the home directory root requires manual confirmation"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.helpful/tmux/set-agent-state.sh\" @claude working"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          },
          {
            "type": "command",
            "command": "\"$HOME/.helpful/tmux/set-agent-state.sh\" @claude idle"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff &"
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/notify-desktop.sh\" \"Done\" Glass"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.helpful/tmux/set-agent-state.sh\" @claude done"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.helpful/tmux/set-agent-state.sh\" @claude working"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
